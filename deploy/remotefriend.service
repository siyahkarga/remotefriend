[Unit]
Description=RemoteFriend rendezvous + relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=remotefriend
Group=remotefriend
WorkingDirectory=/opt/remotefriend
UMask=0077

Environment=RF_RV_PORT=33202
# Yalnızca yerel; nginx HTTPS arkasından. Kurulum betiği port doluysa başka port seçer.
Environment=RF_WEB_PORT=33203
Environment=RF_WEB_BIND=127.0.0.1
Environment=RF_HOST_REGISTRY=/var/lib/remotefriend/hosts.json
Environment=RF_MAX_PENDING=256
Environment=RF_MAX_NATIVE_CONNECTIONS=128
Environment=RF_MAX_WEB_SESSIONS=64
# Sertifika/anahtarı systemd root olarak okuyup servise verir ($CREDENTIALS_DIRECTORY).
# Böylece dosya sahipliği/izinleri yüzünden "Permission denied (os error 13)" olmaz.
LoadCredential=cert.pem:/opt/remotefriend/cert.pem
LoadCredential=key.pem:/opt/remotefriend/key.pem
# Eski systemd (LoadCredential yok) için yedek yol:
Environment=RF_TLS_CERT=/opt/remotefriend/cert.pem
Environment=RF_TLS_KEY=/opt/remotefriend/key.pem
ExecStart=/opt/remotefriend/remote-friend-rendezvous

Restart=always
RestartSec=5
LimitNOFILE=4096
TasksMax=512
# /var/lib/remotefriend'i systemd oluşturur ve servis kullanıcısına verir.
StateDirectory=remotefriend
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
