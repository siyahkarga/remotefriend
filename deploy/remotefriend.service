[Unit]
Description=RemoteFriend rendezvous + relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=remotefriend
Group=remotefriend
WorkingDirectory=/opt/remotefriend
UMask=0077

Environment=RF_RV_PORT=33202
# Local only; served through nginx HTTPS. The setup script picks another port if this one is taken.
Environment=RF_WEB_PORT=33203
Environment=RF_WEB_BIND=127.0.0.1
Environment=RF_HOST_REGISTRY=/var/lib/remotefriend/hosts.json
Environment=RF_MAX_PENDING=256
Environment=RF_MAX_NATIVE_CONNECTIONS=128
Environment=RF_MAX_WEB_SESSIONS=64
# systemd reads the certificate/key as root and hands them to the service ($CREDENTIALS_DIRECTORY),
# so file ownership/permissions can't cause "Permission denied (os error 13)".
LoadCredential=cert.pem:/opt/remotefriend/cert.pem
LoadCredential=key.pem:/opt/remotefriend/key.pem
# Fallback for older systemd (no LoadCredential):
Environment=RF_TLS_CERT=/opt/remotefriend/cert.pem
Environment=RF_TLS_KEY=/opt/remotefriend/key.pem
ExecStart=/opt/remotefriend/remote-friend-rendezvous

Restart=always
RestartSec=5
LimitNOFILE=4096
TasksMax=512
# systemd creates /var/lib/remotefriend and gives it to the service user.
StateDirectory=remotefriend
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
